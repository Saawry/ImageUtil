<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical">

  <ImageView
      android:layout_width="50dp"
      android:layout_height="@dimen/keyline_x2"
      android:layout_gravity="center_horizontal"
      android:layout_marginVertical="@dimen/keyline_x4"
      android:background="@drawable/bg_draggable_view"
      tools:ignore="ContentDescription" />

  <androidx.core.widget.NestedScrollView
      android:id="@+id/optionsItemsScroll"
      android:layout_width="match_parent"
      android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/keyline_x4">

      <include
          android:id="@+id/cropShape"
          layout="@layout/chip_crop_shape_simple" />

      <include
          android:id="@+id/ratio"
          layout="@layout/chip_ratio" />

      <include
          android:id="@+id/guidelines"
          layout="@layout/chip_guidelines" />

      <include
          android:id="@+id/transform"
          layout="@layout/chip_transform" />

    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>
